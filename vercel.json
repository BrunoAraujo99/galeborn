{
  "trailingSlash": true,
  "redirects": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "galeborn-rho.vercel.app" }], "destination": "https://playgaleborn.fun/$1", "permanent": true }
  ],
  "headers": [
    { "source": "/(heroes|audio)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/(img|fonts)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/galeborn-offline.html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
